---
import SiteFooter from '@/components/chrome/SiteFooter.astro';
import SiteHeader from '@/components/chrome/SiteHeader.astro';
import About from '@/components/home/About.astro';
import Contact from '@/components/home/Contact.astro';
import Hero from '@/components/home/Hero.astro';
import Projects from '@/components/home/Projects.astro';
import Services from '@/components/home/Services.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getProjects } from '@/lib/work';

const projects = await getProjects();
const highlighted = projects.filter((project) => project.data.featured);
const selected = (highlighted.length > 0 ? highlighted : projects).slice(0, 3);
---

<BaseLayout footer={false} header={false}>
  <div class="page-frame">
    <SiteHeader />
    <Hero />
    <About />
    <Projects projects={selected} />
    <Services />
    <Contact />

    <SiteFooter closing={false} flush />
  </div>
</BaseLayout>
