---
interface Props {
  totalSlides: number;
}

const { totalSlides } = Astro.props;
const slides = Array.from({ length: totalSlides }, (_, index) => index);
---

<nav class="slide-navigation" aria-label="Navegación de diapositivas">
  <div class="slide-dock">
    <button class="slide-control slide-prev" data-slide-prev aria-label="Diapositiva anterior">
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path d="M19 12H5M12 19l-7-7 7-7" />
      </svg>
    </button>

    <div class="slide-counter" aria-hidden="true">
      <span data-current-slide>1</span>
      <span class="counter-separator">/</span>
      <span>{totalSlides}</span>
    </div>

    <div class="slide-progress">
      {slides.map((index) => (
        <button
          type="button"
          class="slide-dot"
          data-slide-dot={index}
          aria-label={`Ir a la diapositiva ${index + 1}`}
          aria-current={index === 0 ? 'step' : undefined}
        />
      ))}
    </div>

    <button class="slide-control slide-next" data-slide-next aria-label="Diapositiva siguiente">
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path d="M5 12h14M12 5l7 7-7 7" />
      </svg>
    </button>
  </div>

  <p class="sr-only" aria-live="polite" data-slide-status>
    Diapositiva 1 de {totalSlides}
  </p>
</nav>

<style>
  .slide-navigation {
    position: fixed;
    bottom: max(1rem, env(safe-area-inset-bottom, 0px));
    left: 50%;
    z-index: 100;
    width: max-content;
    max-width: calc(100% - 1.5rem);
    transform: translateX(-50%);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      visibility 0s;
  }

  .slide-navigation.is-hidden {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 0.75rem);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      visibility 0s linear 0.2s;
  }

  .slide-dock {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.3rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: var(--night);
    color: var(--night-ink);
    box-shadow: var(--shadow-card);
  }

  .slide-control {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--night-ink);
    cursor: pointer;
    transition:
      background-color 160ms var(--ease-out),
      color 160ms var(--ease-out),
      opacity 160ms var(--ease-out);
  }

  .slide-control:hover:not(:disabled) {
    background: rgb(255 255 255 / 0.12);
    color: #ffffff;
  }

  .slide-control:disabled {
    opacity: 0.28;
    cursor: not-allowed;
  }

  .slide-counter {
    display: flex;
    align-items: baseline;
    justify-content: center;
    min-width: 2.75rem;
    padding: 0 0.25rem;
    color: var(--night-ink);
    font-size: 0.75rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .counter-separator {
    margin: 0 0.2rem;
    color: var(--night-muted);
  }

  .slide-progress {
    display: flex;
    align-items: center;
    gap: 0.125rem;
  }

  .slide-dot {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.75rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
  }

  .slide-dot::before {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.28);
    transition:
      background-color 180ms var(--ease-out),
      scale 180ms var(--ease-out);
  }

  .slide-dot:hover::before {
    background: rgb(255 255 255 / 0.55);
  }

  .slide-dot[aria-current='step']::before {
    scale: 1.5;
    background: var(--accent);
  }

  .slide-control:focus-visible,
  .slide-dot:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @media (max-width: 480px) {
    .slide-navigation {
      max-width: calc(100% - 1rem);
    }

    .slide-dock {
      gap: 0.125rem;
      padding: 0.3rem;
    }

    .slide-control {
      width: 2.5rem;
      height: 2.5rem;
    }

    .slide-counter {
      min-width: 2.25rem;
      font-size: 0.75rem;
    }

    .slide-progress {
      gap: 0;
    }

    .slide-dot {
      width: 1.25rem;
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>

<script>
  function initSlideNavigation() {
    const container = document.querySelector<HTMLElement>('.project-slides');
    const nav = document.querySelector<HTMLElement>('.slide-navigation');
    const slides = document.querySelectorAll<HTMLElement>('[data-slide]');
    const prevBtn = document.querySelector<HTMLButtonElement>('[data-slide-prev]');
    const nextBtn = document.querySelector<HTMLButtonElement>('[data-slide-next]');
    const currentSlideEl = document.querySelector<HTMLElement>('[data-current-slide]');
    const dots = document.querySelectorAll<HTMLButtonElement>('[data-slide-dot]');
    const statusEl = document.querySelector<HTMLElement>('[data-slide-status]');

    if (!container || !slides.length || container.dataset.slideNavReady === 'true') return;
    container.dataset.slideNavReady = 'true';

    let currentSlide = 0;
    let isScrolling = false;
    let slidesInView = true;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const scrollBehavior: ScrollBehavior = reduceMotion ? 'auto' : 'smooth';

    const updateActiveSlide = (index: number) => {
      currentSlide = Math.max(0, Math.min(index, slides.length - 1));

      slides.forEach((slide, i) => {
        slide.classList.toggle('is-active', i === currentSlide);
        slide.toggleAttribute('inert', i !== currentSlide);
      });

      dots.forEach((dot, i) => {
        if (i === currentSlide) {
          dot.setAttribute('aria-current', 'step');
        } else {
          dot.removeAttribute('aria-current');
        }
      });

      if (currentSlideEl) {
        currentSlideEl.textContent = String(currentSlide + 1);
      }

      if (statusEl) {
        statusEl.textContent = `Diapositiva ${currentSlide + 1} de ${slides.length}`;
      }

      if (prevBtn) prevBtn.disabled = currentSlide === 0;
      if (nextBtn) nextBtn.disabled = currentSlide === slides.length - 1;
    };

    const goToSlide = (index: number) => {
      if (isScrolling || index < 0 || index >= slides.length) return;

      isScrolling = true;
      container.scrollTo({ left: index * container.clientWidth, behavior: scrollBehavior });
      slides[index].scrollTo({ top: 0, behavior: scrollBehavior });
      updateActiveSlide(index);

      window.setTimeout(
        () => {
          isScrolling = false;
        },
        reduceMotion ? 50 : 700,
      );
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !isScrolling) {
            const slideIndex = Array.from(slides).indexOf(entry.target as HTMLElement);
            updateActiveSlide(slideIndex);
          }
        });
      },
      { threshold: 0.5 },
    );

    slides.forEach((slide) => observer.observe(slide));

    const visibilityObserver = new IntersectionObserver(
      ([entry]) => {
        slidesInView = entry.isIntersecting;
        nav?.classList.toggle('is-hidden', !slidesInView);
      },
      { threshold: 0.05 },
    );

    visibilityObserver.observe(container);

    prevBtn?.addEventListener('click', () => goToSlide(currentSlide - 1));
    nextBtn?.addEventListener('click', () => goToSlide(currentSlide + 1));

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => goToSlide(index));
    });

    document.addEventListener('keydown', (event) => {
      if (!slidesInView || event.altKey || event.ctrlKey || event.metaKey) return;
      if (
        event.target instanceof Element &&
        event.target.closest('video, input, textarea, select, [contenteditable="true"]')
      ) {
        return;
      }

      if (event.key === 'ArrowRight') {
        event.preventDefault();
        goToSlide(currentSlide + 1);
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        goToSlide(currentSlide - 1);
      } else if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        const isDown = event.key === 'ArrowDown';
        const activeSlide = slides[currentSlide];
        const maxScroll = activeSlide.scrollHeight - activeSlide.clientHeight;

        if (maxScroll > 1) {
          const atTop = activeSlide.scrollTop <= 1;
          const atBottom = activeSlide.scrollTop >= maxScroll - 1;

          if ((isDown && !atBottom) || (!isDown && !atTop)) {
            event.preventDefault();
            activeSlide.scrollBy({
              top: (isDown ? 1 : -1) * activeSlide.clientHeight * 0.8,
              behavior: scrollBehavior,
            });
            return;
          }
        }

        event.preventDefault();
        goToSlide(currentSlide + (isDown ? 1 : -1));
      }
    });

    updateActiveSlide(0);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSlideNavigation);
  } else {
    initSlideNavigation();
  }

  document.addEventListener('astro:after-swap', initSlideNavigation);
</script>
