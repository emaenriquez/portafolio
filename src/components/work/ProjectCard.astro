---
import { Image } from 'astro:assets';
import Icon from '@/components/ui/Icon.astro';
import { projectHref, type Project } from '@/lib/work';

interface Props {
  project: Project;
  /** The first cards on a page load eagerly. */
  eager?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const { project, eager = false, headingLevel: Heading = 'h3' } = Astro.props;
const { title, client, year, services, cover, coverAlt, tint } = project.data;
---

<article class="project-card relative" style={`--tint: ${tint}`}>
  <div class="tint-panel relative aspect-4/3 overflow-hidden rounded-card border border-line">
    <Image
      src={cover}
      alt={coverAlt}
      widths={[640, 960, 1280, 1600]}
      sizes="(min-width: 48rem) 45vw, 100vw"
      quality={90}
      loading={eager ? 'eager' : 'lazy'}
      class="absolute inset-0 size-full object-cover object-top"
    />
  </div>

  <div class="mt-5 flex items-baseline justify-between gap-4 text-sm text-muted">
    <span class="font-mono text-[0.7rem]">{client}</span>
    <span class="font-mono text-[0.7rem]">{year}</span>
  </div>

  <Heading class="serif mt-2 text-title">
    <a href={projectHref(project)} class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-none">
      {title}
    </a>
  </Heading>

  {services.length > 0 && (
    <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Tecnologías">
      {services.slice(0, 3).map((service) => (
        <li class="chip">{service}</li>
      ))}
    </ul>
  )}

  <p class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-ink">
    Ver caso de estudio
    <Icon name="arrow-right" class="icon-nudge size-4 text-muted" />
  </p>
</article>

<style>
  .project-card:has(a:focus-visible) {
    outline: 2px solid var(--ink);
    outline-offset: 8px;
    border-radius: var(--radius-card);
  }

  .tint-panel {
    transition: border-color 200ms var(--ease-out);
  }

  .icon-nudge {
    transition: transform 200ms var(--ease-out);
  }

  @media (hover: hover) {
    .project-card:hover .tint-panel {
      border-color: var(--line-strong);
    }

    .project-card:hover .icon-nudge {
      transform: translateX(3px);
    }
  }
</style>
