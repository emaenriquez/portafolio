---
interface Props {
  class?: string;
}

const { class: className = 'size-7' } = Astro.props;
---

<svg class={className} viewBox="0 0 32 32" fill="none" aria-hidden="true">
  <rect width="32" height="32" rx="8" fill="var(--inverse)"></rect>
  <path
    d="M21 10.5H11v11h10M11 16h6.5"
    stroke="var(--on-inverse)"
    stroke-width="2.6"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
</svg>
