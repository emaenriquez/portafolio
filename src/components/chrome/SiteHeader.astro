---
import ThemeToggle from '@/components/chrome/ThemeToggle.astro';
import Icon from '@/components/ui/Icon.astro';
import { navigation, siteConfig } from '@/config/site';

const path = Astro.url.pathname;
const brand = siteConfig.author.name.replace(/\s+/g, '').toUpperCase();

/* Hash links (`/#servicios`) never mark themselves as the current page. */
const current = (href: string) => {
  if (href.includes('#')) return undefined;
  return path === href ? 'page' : path.startsWith(href) ? 'true' : undefined;
};
---

<header class="site-header">
  <div class="shell flex h-(--header-h) items-center justify-between gap-4">
    <a href="/" class="brand">
      <span aria-hidden="true">&lt;{brand}&gt;</span>
      <span class="sr-only">{siteConfig.author.name}, inicio</span>
    </a>

    <div class="flex items-center gap-5 lg:gap-8">
      <nav aria-label="Principal" class="hidden md:block">
        <ul class="flex items-center gap-7 lg:gap-9">
          {navigation.map((link) => (
            <li>
              <a href={link.href} class="nav-link" aria-current={current(link.href)}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <ThemeToggle />

      <button
        type="button"
        class="grid size-9 place-items-center rounded-full text-ink transition-colors hover:bg-sunken md:hidden"
        commandfor="mobile-nav"
        command="show-modal"
        aria-haspopup="dialog"
        aria-label="Abrir menú"
      >
        <Icon name="menu" class="size-5" />
      </button>
    </div>
  </div>

  <dialog id="mobile-nav" aria-label="Menú" class="mobile-nav md:hidden">
    <div class="shell flex h-(--header-h) items-center justify-between">
      <a href="/" class="brand">
        <span aria-hidden="true">&lt;{brand}&gt;</span>
        <span class="sr-only">{siteConfig.author.name}, inicio</span>
      </a>
      <button
        type="button"
        class="grid size-10 place-items-center rounded-full text-ink hover:bg-sunken"
        commandfor="mobile-nav"
        command="close"
        aria-label="Cerrar menú"
      >
        <Icon name="x" class="size-5" />
      </button>
    </div>

    <nav aria-label="Móvil" class="shell mt-8">
      <ul class="grid">
        <li>
          <a href="/" class="mobile-link" aria-current={path === '/' ? 'page' : undefined}>
            Inicio
          </a>
        </li>
        {navigation.map((link) => (
          <li>
            <a href={link.href} class="mobile-link" aria-current={current(link.href)}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="shell mt-10 grid gap-4">
      <a class="btn btn-accent btn-pill" href={siteConfig.action.href}>
        {siteConfig.action.label}
        <Icon name="arrow-up-right" class="icon-nudge-diagonal size-4" />
      </a>
      <p class="text-sm text-muted">{siteConfig.author.role}</p>
    </div>
  </dialog>
</header>

<script>
  const menu = document.getElementById('mobile-nav') as HTMLDialogElement | null;

  if (menu && !('command' in HTMLButtonElement.prototype)) {
    document.querySelectorAll<HTMLButtonElement>('[commandfor="mobile-nav"]').forEach((button) => {
      button.addEventListener('click', () =>
        button.getAttribute('command') === 'close' ? menu.close() : menu.showModal(),
      );
    });
  }

  menu?.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) menu.close();
  });
  matchMedia('(min-width: 48rem)').addEventListener('change', (event) => event.matches && menu?.close());
</script>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    color: var(--ink);
    font-size: 0.75rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.03em;
    white-space: nowrap;
    transition: opacity 160ms var(--ease-out);
  }

  .brand:hover {
    opacity: 0.6;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    color: var(--ink);
    font-size: 0.75rem;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.45em;
    transition:
      color 160ms var(--ease-out),
      text-decoration-color 160ms var(--ease-out);
  }

  .nav-link:hover,
  .nav-link[aria-current] {
    text-decoration-color: currentColor;
  }

  .mobile-nav {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0 0 2rem;
    border: 0;
    background: var(--canvas);
    color: var(--ink);
  }

  .mobile-link {
    display: flex;
    align-items: center;
    min-height: 3.75rem;
    border-bottom: 1px solid var(--line);
    font-size: clamp(1.6rem, 6vw, 2.1rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .mobile-link[aria-current] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 0.12em;
    text-underline-offset: 0.18em;
  }

  @media (prefers-reduced-motion: no-preference) {
    .mobile-nav {
      transition:
        opacity 220ms var(--ease-out),
        translate 320ms var(--ease-out),
        display 320ms allow-discrete,
        overlay 320ms allow-discrete;
    }

    .mobile-nav:not([open]) {
      opacity: 0;
      translate: 0 -0.75rem;
    }

    @starting-style {
      .mobile-nav[open] {
        opacity: 0;
        translate: 0 -0.75rem;
      }
    }
  }
</style>
