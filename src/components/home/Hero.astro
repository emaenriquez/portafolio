---
import Icon from '@/components/ui/Icon.astro';
import { hero } from '@/config/home';
---

<section class="shell pt-6 pb-14 sm:pt-8 sm:pb-16 lg:pt-10 lg:pb-20" aria-labelledby="hero-title">
  <h1 id="hero-title" class="rise text-hero font-extrabold uppercase">
    <span class="block">{hero.title}</span>
    <span class="block">{hero.name}</span>
  </h1>

  <div class="mt-8 grid grid-cols-1 gap-10 lg:mt-10 lg:grid-cols-[minmax(0,1fr)_27rem] lg:items-start lg:gap-16">
    <div class="rise max-w-[26rem] min-w-0" style="--rise-step: 1">
      <p class="text-[0.78rem] font-medium tracking-[0.01em] text-ink">{`<${hero.stack.join(' ')}>`}</p>

      <p class="mt-4 text-[1rem] leading-relaxed text-body">{hero.text}</p>

      <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-4">
        <a class="btn btn-accent btn-pill px-6" href={hero.primary.href}>
          {hero.primary.label}
          <Icon name="arrow-up-right" class="icon-nudge-diagonal size-4" />
        </a>
        <a class="cta-quiet" href={hero.secondary.href}>
          {hero.secondary.label}
        </a>
      </div>
    </div>

    <div class="hero-video-card rise" style="--rise-step: 2">
      <video class="hero-video" autoplay muted loop playsinline preload="auto" aria-label="Video de contribuciones">
        <source src="/videos/video.mp4" type="video/mp4" />
      </video>
    </div>
  </div>
</section>

<style>
  .hero-video-card {
    border-radius: var(--radius-card, 0.875rem);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .hero-video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: inherit;
    object-fit: cover;
  }

  .cta-quiet {
    color: var(--ink);
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--ink) 30%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.28em;
    transition: text-decoration-color 160ms var(--ease-out);
  }

  .cta-quiet:hover {
    text-decoration-color: var(--ink);
  }
</style>
