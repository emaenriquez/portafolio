---
import { Image } from 'astro:assets';
import Icon from '@/components/ui/Icon.astro';
import { work } from '@/config/home';
import { projectHref, type Project } from '@/lib/work';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<section id="proyectos" class="band bg-night py-20 text-night-ink sm:py-24 lg:py-28">
  <h2 class="display-1 max-w-[16ch] text-white">{work.title}</h2>

  <div class="mt-12 space-y-12 sm:mt-16 sm:space-y-16">
    {projects.map((project, index) => {
      const { client, year, role, summary, services, cover, tint, how } = project.data;
      return (
        <article class="group relative grid gap-8 border-t border-white/10 pt-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.12fr)] lg:items-start lg:gap-16 lg:pt-10">
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
              <span class="font-mono text-[0.7rem] text-white/40">{String(index + 1).padStart(2, '0')}</span>
              <span class="label text-white/55">{client}</span>
              <span class="rounded-full border border-white/15 px-2.5 py-1 text-[0.66rem] font-medium text-white/70">
                {year}
              </span>
            </div>

            <h3 class="display-3 mt-4 text-white">
              <a href={projectHref(project)} class="transition-opacity hover:opacity-70">
                {client}
              </a>
            </h3>

            <dl class="mt-6 space-y-3">
              <div>
                <dt class="label text-white/40">Rol</dt>
                <dd class="mt-1 text-[0.8rem] font-semibold text-[#CDF564]">{role}</dd>
              </div>
              <div>
                <dt class="label text-white/40">Stack</dt>
                <dd class="mt-1 text-[0.8rem] font-semibold text-white">{services.slice(0, 3).join(' · ')}</dd>
              </div>
            </dl>

            <p class="mt-6 max-w-[46ch] text-[0.86rem] leading-relaxed text-white/65">{summary}</p>
            {how[0] && <p class="mt-3 max-w-[46ch] text-[0.86rem] leading-relaxed text-white/45">{how[0]}</p>}

            <a
              class="mt-6 inline-flex items-center gap-2 text-[0.78rem] font-semibold text-white underline decoration-white/30 underline-offset-4 transition-colors hover:decoration-white"
              href={projectHref(project)}
            >
              Ver caso de estudio
              <Icon name="arrow-up-right" class="icon-nudge-diagonal size-3.5 text-[#CDF564]" />
            </a>
          </div>

          <a
            class="relative aspect-4/3 overflow-hidden rounded-[1.25rem] border border-white/10"
            style={`background: ${tint}`}
            href={projectHref(project)}
            tabindex="-1"
            aria-hidden="true"
          >
            <Image
              src={cover}
              alt=""
              widths={[640, 960, 1280, 1600]}
              sizes="(min-width: 64rem) 44vw, 92vw"
              quality={90}
              loading={index === 0 ? 'eager' : 'lazy'}
              class="absolute inset-0 size-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.02]"
            />
          </a>
        </article>
      );
    })}
  </div>

  <div class="mt-14 flex flex-col items-start justify-between gap-6 border-t border-white/10 pt-8 sm:flex-row sm:items-center">
    <p class="max-w-[34ch] text-[0.84rem] leading-relaxed text-white/50">
      Cada proyecto, con su alcance, stack y decisiones. Tres fichas completas en una página aparte.
    </p>
    <a class="btn btn-accent btn-pill px-6" href="/work/">
      Ver todos los proyectos
      <Icon name="arrow-up-right" class="icon-nudge-diagonal size-4" />
    </a>
  </div>
</section>

<style>
  article:has(a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 12px;
    border-radius: 0.75rem;
  }

  .icon-nudge-diagonal {
    transition: transform 200ms var(--ease-out);
  }

  @media (hover: hover) {
    article:hover .icon-nudge-diagonal {
      transform: translate(2px, -2px);
    }
  }
</style>
