---
import { aboutSection, experienceSection } from '@/config/home';
import { resume } from '@/config/resume';

const dash = (period: string) => period.replace(' - ', ' — ');

const entries = [
  ...resume.experience.map((job) => ({
    place: job.company,
    role: job.role,
    period: job.period,
    text: job.text,
    points: job.highlights,
  })),
  ...resume.education.map((item) => ({
    place: item.place,
    role: item.title,
    period: item.period,
    text: item.text,
    points: [] as string[],
  })),
];
---

<section id="sobre-mi" class="band border-t border-line pt-16 pb-20 sm:pt-24 lg:pt-28">
  <p class="label">{aboutSection.eyebrow}</p>
  <h2 class="display-2 mt-4 max-w-[24ch]">{aboutSection.title}</h2>

  <div class="mt-10 grid gap-10 lg:mt-12 lg:grid-cols-2 lg:gap-20">
    <div class="max-w-[54ch] space-y-4 text-[0.98rem] leading-relaxed text-body">
      {aboutSection.paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>

    <dl class="self-start">
      {aboutSection.facts.map((fact) => (
        <div class="flex items-center justify-between gap-6 border-t border-line py-3.5">
          <dt class="label">{fact.label}</dt>
          <dd class="text-right text-[0.8rem] font-semibold text-ink">{fact.value}</dd>
        </div>
      ))}
    </dl>
  </div>

  <div id="experiencia" class="mt-20 scroll-mt-24 sm:mt-24">
    <div class="flex flex-wrap items-baseline justify-between gap-3 border-t border-line pt-4">
      <h3 class="label">{experienceSection.eyebrow}</h3>
      <p class="label">{experienceSection.caption}</p>
    </div>

    <ol class="mt-1">
      {entries.map((entry) => (
        <li class="grid gap-3 border-b border-line py-6 sm:gap-4 sm:py-7 lg:grid-cols-[19rem_minmax(0,1fr)_auto] lg:gap-10">
          <div>
            <p class="label">{entry.place}</p>
            <h4 class="display-3 mt-1.5">{entry.role}</h4>
          </div>

          <div class="max-w-[62ch] text-[0.84rem] leading-relaxed text-body">
            <p>{entry.text}</p>
            {entry.points.length > 0 && (
              <ul class="mt-3 space-y-1 text-[0.8rem] text-muted">
                {entry.points.map((point) => (
                  <li class="flex gap-2">
                    <span aria-hidden="true">·</span>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>

          <p class="label whitespace-nowrap lg:pt-1 lg:text-right">{dash(entry.period)}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
