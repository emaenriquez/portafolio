---
import Icon from '@/components/ui/Icon.astro';
import { contact } from '@/config/home';
import { siteConfig } from '@/config/site';

const { email } = siteConfig.author;
const linkedin = siteConfig.socials.find((social) => social.label === 'LinkedIn')?.href;
---

<section id="contacto" class="band bg-accent py-16 text-[#111111] sm:py-20 lg:py-24" aria-labelledby="contacto-title">
  <p class="label text-[#111111]/55">{contact.eyebrow}</p>

  <div class="mt-5 grid gap-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:items-end lg:gap-16">
    <h2 id="contacto-title" class="display-2 max-w-[18ch] text-[#111111]">
      {contact.title}
    </h2>

    <div class="max-w-[44ch]">
      <p class="text-[0.92rem] leading-relaxed text-[#111111]/70">{contact.text}</p>

      <div class="mt-7 flex flex-wrap items-center gap-3">
        <a class="btn btn-pill bg-[#111111] px-6 text-white hover:bg-[#111111]/85" href={`mailto:${email}`}>
          <span class="sm:hidden">Escribime</span>
          <span class="hidden sm:inline">{email}</span>
          <Icon name="arrow-up-right" class="icon-nudge-diagonal size-4" />
        </a>
        {linkedin && (
          <a
            class="btn btn-pill border border-[#111111]/30 px-5 text-[#111111] hover:border-[#111111] hover:bg-transparent"
            href={linkedin}
            rel="me noopener"
          >
            LinkedIn
            <Icon name="arrow-up-right" class="icon-nudge-diagonal size-4" />
          </a>
        )}
      </div>
    </div>
  </div>
</section>
